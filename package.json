{
  "name": "plantuml-interactive-editor",
  "version": "0.1.0",
  "description": "PlantUML Interactive Desktop Editor — drag-and-drop diagram editing on Windows",
  "main": "dist-electron/main/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "tsc && vite build",
    "build:electron": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "dependencies": {
    "ace-builds": "^1.36.2",
    "lodash.debounce": "^4.0.8",
    "react": "^18.3.1",
    "react-ace": "^10.1.0",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.plantuml.interactive-editor",
    "productName": "PlantUML Interactive Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlantUML Interactive Editor"
    },
    "extraResources": [
      {
        "from": "src/python-backend/dist/",
        "to": "python-backend/",
        "filter": ["**/*"]
      }
    ]
  }
}
